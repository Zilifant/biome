{
  "name": "biome",
  "version": "0.1.0",
  "description": "Deterministic, headless animal ecosystem simulation engine with a versioned renderer protocol",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/createServer.js",
    "dev": "nodemon src/server/createServer.js",
    "headless": "node src/scripts/runHeadless.js",
    "benchmark": "node src/scripts/benchmark.js",
    "ethologist": "node src/scripts/ethologist.js",
    "sweep": "node src/scripts/sweep.js",
    "fixtures:renderer": "node src/scripts/generateRendererFixtures.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:report": "playwright show-report"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.61.1",
    "nodemon": "^3.1.0"
  }
}